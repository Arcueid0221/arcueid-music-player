{
  "name": "arcueid-music-player",
  "private": true,
  "version": "0.2.0",
  "description": "A framework-agnostic Web Component music player with static JSON and API-backed multi-playlist support.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Arcueid0221/arcueid-music-player.git"
  },
  "homepage": "https://github.com/Arcueid0221/arcueid-music-player#readme",
  "bugs": {
    "url": "https://github.com/Arcueid0221/arcueid-music-player/issues"
  },
  "keywords": [
    "music-player",
    "web-component",
    "typescript",
    "playlist",
    "audio"
  ],
  "type": "module",
  "module": "./dist/arcueid-music-player.js",
  "types": "./dist/arcueid-music-player.d.ts",
  "unpkg": "./dist/arcueid-music-player.min.js",
  "exports": {
    ".": {
      "types": "./dist/arcueid-music-player.d.ts",
      "import": "./dist/arcueid-music-player.js"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "lucide": "^1.34.0"
  }
}
